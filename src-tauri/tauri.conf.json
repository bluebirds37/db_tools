{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "db_tools",
  "version": "0.1.0",
  "identifier": "com.vibe.dbtools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:44100",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "db_tools — 多数据库管理",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "多数据库管理工具",
    "longDescription": "db_tools — Tauri 2 多数据库管理桌面应用，支持 MySQL、PostgreSQL、PgVector、SQLite、Redis、MongoDB、Elasticsearch、Qdrant，提供结构编辑、数据 CRUD、跨引擎同步与迁移、导出脱敏、SQL 备份以及内置 AI 智能体。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
